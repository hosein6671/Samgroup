{
  "extends": "@sam-group/tsconfig/base.json",
  "compilerOptions": {
    // The shared base targets Node. This app renders DOM, so browser libs are added here
    // rather than in the base, which must not hand browser types to the server packages.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // Next.js compiles JSX itself; the base's "react-jsx" would fight its SWC pipeline.
    "jsx": "preserve",
    "types": ["node", "react"],
    "allowJs": true,
    "incremental": true,
    "moduleDetection": "force",
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      // Spec-only helpers under `test/`, mirroring the alias in vitest.config.mts so a spec and
      // `tsc --noEmit` resolve the same specifier. Nothing under `src` outside a `.spec` file
      // imports it, and `test/` is not in `include` — the files enter the program only as
      // dependencies of the specs that use them, and never reach a Next build.
      "@test/*": ["./test/*"]
    }
  },
  "include": ["next-env.d.ts", "next.config.ts", "src", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next"]
}
