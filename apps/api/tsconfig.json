{
  "extends": "@sam-group/tsconfig/base.json",
  "compilerOptions": {
    // node16 rather than commonjs/node10: TypeScript 6.0.3 rejects moduleResolution
    // "node10" outright (TS5107 — removed in TypeScript 7.0). This package has no
    // "type": "module", so node16 still emits CommonJS, which is what NestJS needs.
    "module": "node16",
    "moduleResolution": "node16",
    "noEmit": false,
    "declaration": false,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "types": ["node", "jest"]
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules"]
}
