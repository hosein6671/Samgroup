# ---------------------------------------------------------------------------
# Copy to `.env` and adjust. `.env` is git-ignored and must never be committed.
#
# The active values below are LOCAL DEVELOPMENT DEFAULTS. They work with no DNS
# and no certificates. Production values are listed at the bottom for
# reference — they belong in the VPS's own `.env`, injected at deploy time and
# never baked into an image (docs/SECURITY.md "Secrets Management").
# ---------------------------------------------------------------------------

# --- PostgreSQL -------------------------------------------------------------
# Superuser. Used only by the container entrypoint and by backups.
# Neither application ever connects with these credentials.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local-dev-only-change-me
POSTGRES_DB=postgres

# sam_platform — owned and migrated by Prisma, used only by apps/api (ADR-002).
POSTGRES_PLATFORM_DB=sam_platform
POSTGRES_PLATFORM_USER=sam_platform_user
POSTGRES_PLATFORM_PASSWORD=local-dev-only-change-me

# sam_cms — owned and migrated by Payload, used only by apps/cms (ADR-002).
POSTGRES_CMS_DB=sam_cms
POSTGRES_CMS_USER=sam_cms_user
POSTGRES_CMS_PASSWORD=local-dev-only-change-me

# Host port used ONLY if you opt into local database access. Nothing is
# published by default — see docker-compose.override.yml.
POSTGRES_LOCAL_PORT=5432

# --- MinIO ------------------------------------------------------------------
MINIO_ROOT_USER=local-dev-minio
MINIO_ROOT_PASSWORD=local-dev-only-change-me

# Two buckets by design — see docs/DEVOPS.md "Object storage (MinIO)".
#   public : product imagery and other freely readable media
#   private: CVs and confidential documents, never anonymously readable
MINIO_PUBLIC_BUCKET=sam-public
MINIO_PRIVATE_BUCKET=sam-private

# --- Hosts ------------------------------------------------------------------
# Local development defaults. These need no DNS: browsers resolve `localhost`
# and any `*.localhost` name to the loopback address on their own.
PUBLIC_HOST=localhost
CMS_HOST=cms.localhost

# Host port for the local proxy. 8080 rather than 80 so it needs no elevated
# privileges and cannot collide with something already bound to port 80.
HTTP_PORT=8080

# --- Upstreams --------------------------------------------------------------
# In development the applications run on the HOST via `pnpm dev`, so nginx
# proxies to the host gateway. Ports differ because all three share one
# machine. In production they are containers and these become service names —
# see the production block below.
WEB_UPSTREAM=http://host.docker.internal:3000
API_UPSTREAM=http://host.docker.internal:3001
CMS_UPSTREAM=http://host.docker.internal:3002

# MinIO's S3 endpoint as nginx sees it. A compose service name rather than a
# public host, so it is identical in development and production — but it lives
# here rather than in docker-compose.yml so that every nginx upstream comes
# from one place.
MINIO_UPSTREAM=http://minio:9000

# ---------------------------------------------------------------------------
# PRODUCTION REFERENCE — do not enable locally
#
# Confirmed production domain: samgp.com, with Payload's admin on its own
# subdomain (ADR-005). Set these in the VPS `.env` only. Leaving them commented
# here is what keeps local development independent of DNS and certificates.
#
#   PUBLIC_HOST=samgp.com
#   CMS_HOST=cms.samgp.com
#
#   WEB_UPSTREAM=http://web:3000
#   API_UPSTREAM=http://api:3000
#   CMS_UPSTREAM=http://cms:3000
#
#   HTTP_PORT=80
#
# TLS is not enabled by either configuration yet. Certificates are issued with
# Let's Encrypt during the VPS setup phase — the procedure and the ordering
# constraint are in docker/nginx/README.md.
# ---------------------------------------------------------------------------
