# Copy to deploy/mail.env on the VPS. Never commit the real file.
# Read docs/MAIL_SERVER_SETUP.md before touching any value below — it has the
# DNS records this configuration promises to be truthful about, and the exact
# commands to create mailboxes and DKIM keys.

# The mail server's own hostname — NOT the same as PUBLIC_HOST. A dedicated
# subdomain so the mail server's reverse-DNS (PTR) and certificate never
# collide with the web app's. Set the matching MX/A record before starting.
MAIL_HOSTNAME=mail.samgp.com

# Same shape "example.com" for now; every mailbox created with `setup email
# add` fixes it going forward — see the runbook for the twelve addresses.
OVERRIDE_HOSTNAME=mail.samgp.com

# --- Security posture — verified locally 15 September 2026, do not relax ---
# `none` forces authentication for every send. `network`/`connected-networks`
# are documented upstream as a way to accidentally create an open relay.
PERMIT_DOCKER=none
# Avoids an IPv6 relay hole when the host has IPv6 but the Docker network
# does not.
POSTFIX_INET_PROTOCOLS=ipv4
# One spam/DKIM/SPF/DMARC engine. OpenDKIM must stay off when Rspamd is on —
# running both is unsupported and DKIM signing silently stops working.
ENABLE_RSPAMD=1
ENABLE_OPENDKIM=0
ENABLE_OPENDMARC=0
ENABLE_POLICYD_SPF=1
# Amavis is a SEPARATE toggle from OpenDKIM and defaults to ON even with Rspamd enabled — the
# image's own startup log warns "Running Amavis/SA & Rspamd at the same time is discouraged".
# Confirmed live, 18 September 2026: leaving it on caused real Gmail deliveries to be rejected
# with a milter timeout on this VPS's modest RAM. Off, so Rspamd is genuinely the only scanner.
ENABLE_AMAVIS=0
# Brute-force protection on Postfix/Dovecot auth. Requires the `NET_ADMIN`
# capability already declared in docker-compose.mail.yml.
ENABLE_FAIL2BAN=1

# The real certificate, reused from the same certbot volume nginx uses for
# the web app's TLS — set up in the SSL/TLS gate, not here. Never
# `self-signed` for this domain; upstream documentation is explicit that mode
# is for testing only.
SSL_TYPE=letsencrypt

# Antivirus scanning. Left OFF by default: upstream recommends 3-4 GB RAM
# when this is enabled, and this VPS also runs postgres, minio, api, web and
# cms. Turn this on only after confirming the VPS has the headroom for it —
# a capacity decision, not a default to inherit silently.
ENABLE_CLAMAV=0
