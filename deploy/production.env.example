# Copy to `.env` on the VPS. Generate every value marked SECRET; never commit the real file.
SAM_IMAGE_PREFIX=ghcr.io/OWNER/sam-group-platform
SAM_IMAGE_TAG=REPLACE_WITH_COMMIT_SHA

POSTGRES_USER=postgres
POSTGRES_PASSWORD=SECRET
POSTGRES_DB=postgres
POSTGRES_PLATFORM_DB=sam_platform
POSTGRES_PLATFORM_USER=sam_platform_user
POSTGRES_PLATFORM_PASSWORD=SECRET
POSTGRES_CMS_DB=sam_cms
POSTGRES_CMS_USER=sam_cms_user
POSTGRES_CMS_PASSWORD=SECRET
DATABASE_URL=postgresql://sam_platform_user:SECRET@postgres:5432/sam_platform?schema=public
DATABASE_URI=postgresql://sam_cms_user:SECRET@postgres:5432/sam_cms

MINIO_ROOT_USER=SECRET
MINIO_ROOT_PASSWORD=SECRET
MINIO_PUBLIC_BUCKET=sam-public
MINIO_PRIVATE_BUCKET=sam-private

PUBLIC_HOST=samgp.com
CMS_HOST=cms.samgp.com
SITE_PUBLIC_URL=https://samgp.com
# Keep false for test deployments. Open indexing only after the launch checklist is approved.
SITE_SEO_INDEXING=false

JWT_SECRET=SECRET_AT_LEAST_32_CHARACTERS
PAYLOAD_SECRET=SECRET_AT_LEAST_32_CHARACTERS
PAYLOAD_API_KEY=
PAYLOAD_EDITOR_SECRET=SECRET_AT_LEAST_32_CHARACTERS

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=
MAIL_FROM=
LEAD_NOTIFICATION_TO=
TURNSTILE_SECRET_KEY=
