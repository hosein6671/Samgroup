{
  "name": "sam-group-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "seed:catalog": "tsx prisma/seed-catalog.ts",
    "load:product-copy": "tsx prisma/load-product-copy-drafts.ts",
    "catalog:import": "tsx apps/api/src/modules/catalog/import/catalog-import.run.ts",
    "catalog:increment": "tsx apps/api/src/modules/catalog/import/incremental/catalog-increment.run.ts",
    "catalog:sources:capture": "tsx apps/api/src/modules/catalog/import/capture/source-capture.run.ts",
    "seed:admin": "tsx prisma/seed-admin.ts",
    "seed:categories": "tsx prisma/seed-categories.ts",
    "seed:products:demo": "tsx prisma/seed-products-demo.ts",
    "seed:blog:demo": "tsx prisma/seed-blog-demo.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "argon2": "0.44.0"
  },
  "devDependencies": {
    "@sam-group/eslint-config": "workspace:*",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prisma": "7.9.1",
    "tsx": "^4.23.11",
    "turbo": "^2.10.8"
  }
}
